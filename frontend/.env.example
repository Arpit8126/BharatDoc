# -----------------------------------------------------------------------------
# BharatDoc Frontend Environment Variables Example
# Add these in Vercel Project Settings -> Environment Variables
# -----------------------------------------------------------------------------

# Backend API URL (e.g. Render / Railway / Cloud Run or local)
VITE_BACKEND_URL=https://your-backend-api-url.onrender.com

# Supabase Cloud Project Configuration (Optional for Client Auth & History)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
