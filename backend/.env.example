# -----------------------------------------------------------------------------
# BharatDoc Backend Environment Variables Example
# Copy this file to .env in the backend/ directory and fill in your keys.
# -----------------------------------------------------------------------------

# Google Gemini API Key (Required for Vision OCR & Clinical Reasoning)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Cloud Project Configuration (Optional for persistence)
# Get your project credentials from: https://supabase.com/dashboard
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
